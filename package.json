{
  "name": "mf-food",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "M-F-FOOD restaurant ordering app — React + Supabase (PostgreSQL)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs supabase/tests/*.test.mjs && vitest run src",
    "validate:production-env": "node scripts/validate-production-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
