# ---------------------------------------------------------------------------
# M-F-FOOD — environment configuration
# Copy this file to ".env" and fill in your Supabase project credentials.
# You can find both values in the Supabase dashboard:
#   Project Settings → API → Project URL / anon public key
#
# The anon key is safe to expose in the browser ONLY because every table is
# protected by Row Level Security (see supabase/migrations). Never put the
# service_role key in any VITE_* variable.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# When these variables are missing the app runs in "demo mode":
# menu/cart UI works with bundled sample data and orders/auth are simulated
# locally — no data ever leaves the browser.
